# --- Database: TWO distinct connection strings, do not mix up ---

# POOLED — used by the APP at runtime (transaction-mode pooler).
# If using asyncpg, statement_cache_size=0 is required through this pooler.
DATABASE_URL=

# DIRECT — used by Alembic migrations ONLY. Never point the app at this.
# Using the wrong string here/there causes "relation does not exist".
DATABASE_URL_DIRECT=

# --- LLM ---

OPENAI_API_KEY=
# Pin the exact model string. Do not use an alias (e.g. "latest").
OPENAI_MODEL=

# --- App ---

ENV=
LOG_LEVEL=

# --- Optional, defaults apply if absent (app/main.py) ---

# off | shadow | enforce. Defaults to "shadow" if absent/invalid.
CALIBRATION_MODE=
# Defaults to 30 minutes if absent.
CONFIRM_TTL_MINUTES=
# Defaults to 4 hours if absent.
FULL_REVIEW_TTL_HOURS=

# --- Build/deploy-time only — NOT for local .env ---
# Computed by infra/railway/deploy-railway.sh and infra/aws/deploy-lambda.sh
# at deploy time; GET /v1/version reports "unknown" locally if absent,
# which is expected for local development. Left unset here deliberately.
# GIT_SHA=
# BUILD_TIME=
