#!/bin/sh
# Blocks commits containing key-shaped strings. Installed into
# .git/hooks/pre-commit by scripts/install-hooks.sh (git does not version
# .git/hooks, so this canonical copy lives in scripts/ and gets copied in).

set -e

pattern='sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(SECRET|TOKEN|PASSWORD|API_KEY)[A-Za-z_]*[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9/+_-]{16,}'

staged=$(git diff --cached --name-only --diff-filter=ACM)
found=0

for f in $staged; do
  [ -f "$f" ] || continue
  if git diff --cached -- "$f" | grep -Ein "$pattern" >/dev/null 2>&1; then
    echo "BLOCKED: possible secret in $f" >&2
    git diff --cached -- "$f" | grep -Ein "$pattern" >&2
    found=1
  fi
done

if [ "$found" -eq 1 ]; then
  echo "Commit blocked by pre-commit secret scan. Remove the key-shaped string(s) above, or use .env (gitignored)." >&2
  exit 1
fi

exit 0
